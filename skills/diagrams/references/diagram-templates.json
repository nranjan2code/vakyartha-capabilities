          "group": "Edge",
          "shape": "box"
        },
        {
          "id": "auth",
          "label": "Auth Service",
          "group": "Core",
          "shape": "box"
        },
        {
          "id": "app",
          "label": "Application Service",
          "group": "Core",
          "shape": "box"
        },
        {
          "id": "cache",
          "label": "Cache",
          "group": "Data",
          "shape": "cylinder"
        },
        {
          "id": "db",
          "label": "Primary database",
          "group": "Data",
          "shape": "cylinder"
        }
      ],
      "edges": [
        {
          "from": "client",
          "to": "gateway",
          "label": "HTTPS / JSON"
        },
        {
          "from": "gateway",
          "to": "auth",
          "label": "validates JWT"
        },
        {
          "from": "gateway",
          "to": "app",
          "label": "routes request"
        },
        {
          "from": "app",
          "to": "cache",
          "label": "reads cache"
        },
        {
          "from": "app",
          "to": "db",
          "label": "queries & persists"
        }
      ],
      "subgraphs": [
        {
          "id": "sg-edge",
          "label": "Edge Tier",
          "nodes": [
            "gateway",
            "auth"
          ]
        },
        {
          "id": "sg-core",
          "label": "Backend Tier",
          "nodes": [
            "app"
          ]
        },
        {
          "id": "sg-data",
          "label": "Data Tier",
          "nodes": [
            "cache",
            "db"
          ]
        }
      ]
    }
  },
  "feedback_control_loop": {
    "type": "diagram",
    "props": {
      "kind": "flow",
      "directed": true,
      "nodes": [
        {
          "id": "objective",
          "label": "System Goal",
          "group": "Strategy",
          "shape": "pill"
        },
        {
          "id": "sensor",
          "label": "Telemetry & Inputs",
          "group": "Perception",
          "shape": "cylinder"
        },
        {
          "id": "controller",
          "label": "Inference Controller",
          "group": "Processing",
          "shape": "box"
        },
        {
          "id": "guard",
          "label": "Safety Policy",
          "group": "Governance",
          "shape": "diamond"
        },
        {
          "id": "actuator",
          "label": "Actuator / Action",
          "group": "Execution",
          "shape": "box"
        },
        {
          "id": "observer",
          "label": "Outcome Observer",
          "group": "Evaluation",
          "shape": "pill"
        }
      ],
      "edges": [
        {
          "from": "objective",
          "to": "sensor",
          "label": "sets parameters"
        },
        {
          "from": "sensor",
          "to": "controller",
          "label": "streams telemetry"
        },
        {
          "from": "controller",
          "to": "guard",
          "label": "proposes change"
        },
        {
          "from": "guard",
          "to": "actuator",
          "label": "enforces bounds"
        },
        {
          "from": "actuator",
          "to": "observer",
          "label": "affects environment"
        },
        {
          "from": "observer",
          "to": "objective",
          "label": "corrects drift"
        },
        {
          "from": "observer",
          "to": "sensor",
          "label": "calibrates baselines"
        }
      ]
    }
  },
