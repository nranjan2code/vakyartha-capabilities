{
  "flowchart": {
    "type": "diagram",
    "props": {
      "kind": "flow",
      "directed": true,
      "nodes": [
        {
          "id": "start",
          "label": "Start Process",
          "group": "Boundary",
          "shape": "pill"
        },
        {
          "id": "validate",
          "label": "Validate Input",
          "group": "Process",
          "shape": "box"
        },
        {
          "id": "check",
          "label": "Checks Pass?",
          "group": "Decision",
          "shape": "diamond"
        },
        {
          "id": "fix",
          "label": "Request Correction",
          "group": "Exception",
          "shape": "box"
        },
        {
          "id": "execute",
          "label": "Execute Action",
          "group": "Process",
          "shape": "box"
        },
        {
          "id": "end",
          "label": "Completed",
          "group": "Boundary",
          "shape": "pill"
        }
      ],
      "edges": [
        {
          "from": "start",
          "to": "validate",
          "label": "initiates"
        },
        {
          "from": "validate",
          "to": "check",
          "label": "evaluates"
        },
        {
          "from": "check",
          "to": "execute",
          "label": "yes"
        },
        {
          "from": "check",
          "to": "fix",
          "label": "no"
        },
        {
          "from": "fix",
          "to": "validate",
          "label": "resubmits"
        },
        {
          "from": "execute",
          "to": "end",
          "label": "finishes"
        }
      ]
    }
  },
  "architecture": {
    "type": "diagram",
    "props": {
      "kind": "flow",
      "directed": true,
      "nodes": [
        {
          "id": "client",
          "label": "Web & Mobile Client",
          "group": "Frontend",
          "shape": "pill"
        },
        {
