  "state_machine": {
    "type": "diagram",
    "props": {
      "kind": "state",
      "directed": true,
      "nodes": [
        {
          "id": "draft",
          "label": "Draft",
          "group": "Open",
          "shape": "pill"
        },
        {
          "id": "submitted",
          "label": "Submitted",
          "group": "Open"
        },
        {
          "id": "review",
          "label": "In review",
          "group": "Open",
          "shape": "diamond"
        },
        {
          "id": "approved",
          "label": "Approved",
          "group": "Closed",
          "shape": "pill"
        },
        {
          "id": "rejected",
          "label": "Rejected",
          "group": "Closed",
          "shape": "pill"
        }
      ],
      "edges": [
        {
          "from": "draft",
          "to": "submitted",
          "label": "submit [fields complete]"
        },
        {
          "from": "submitted",
          "to": "review",
          "label": "assign reviewer"
        },
        {
          "from": "review",
          "to": "approved",
          "label": "approve"
        },
        {
          "from": "review",
          "to": "rejected",
          "label": "reject"
        },
        {
          "from": "review",
          "to": "draft",
          "label": "request changes"
        }
      ]
    }
  },
