    "nodes": [
      {
        "id": "root",
        "type": "stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "summary",
          "capture",
          "capture-bar",
          "tabbed"
        ]
      },
      {
        "id": "summary",
        "type": "text",
        "props": {
          "content": "{/summary}",
          "variant": "caption"
        }
      },
      {
        "id": "capture",
        "type": "form",
        "props": {
          "submit": "capture_task",
          "submitLabel": "Add task"
        },
        "children": [
          "capture-input",
          "capture-preview"
        ]
      },
      {
        "id": "capture-input",
        "type": "input",
        "props": {
          "label": "Quick capture",
          "bind": "/capture",
          "placeholder": "Call the bank tomorrow at 5pm !high"
        }
      },
      {
        "id": "capture-preview",
        "type": "text",
        "props": {
          "content": "{/capturePreview}",
          "variant": "caption",
          "visibleIf": "{/capturePreview}"
        }
      },
      {
        "id": "capture-bar",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm"
        },
        "children": [
          "capture-dictate",
          "new-task",
          "capture-help"
        ]
      },
      {
        "id": "capture-dictate",
        "type": "button",
        "props": {
          "label": "Dictate",
          "action": "voice.dictate",
          "payload": {
            "into": "capture-input"
          },
          "style": "secondary"
        }
      },
      {
        "id": "new-task",
        "type": "button",
        "props": {
          "label": "Add with details",
          "action": "new_task",
          "style": "secondary"
        }
      },
      {
        "id": "capture-help",
        "type": "text",
        "props": {
          "content": "Type a day, time, repeat or priority with the task: friday, 12 nov, at 9:30, for 1h, every week, !high.",
          "variant": "caption"
        }
      },
      {
        "id": "tabbed",
        "type": "tabs",
        "props": {},
        "children": [
          "today-panel",
          "upcoming-panel",
          "all-panel",
          "completed-panel",
          "insights-panel"
        ]
      },
      {
        "id": "today-panel",
        "type": "section",
        "props": {
          "title": "Today",
          "description": "{/counts/today} due today · {/counts/overdue} overdue"
        },
        "children": [
          "today-list",
          "today-empty"
        ]
      },
      {
        "id": "today-list",
        "type": "stack",
        "props": {
          "gap": "sm"
        },
        "children": {
          "each": "/today",
          "template": "task-row"
        }
      },
      {
        "id": "today-empty",
        "type": "text",
        "props": {
          "content": "Nothing is due today. Tasks with today's date or an earlier one appear here.",
          "variant": "caption",
          "visibleIf": "{/noToday}"
        }
      },
      {
        "id": "upcoming-panel",
        "type": "section",
        "props": {
          "title": "Upcoming",
          "description": "Dated tasks by month, week, day or agenda, then the list in date order."
        },
        "children": [
          "calendar",
          "upcoming-list",
          "upcoming-empty"
        ]
      },
      {
        "id": "calendar",
        "type": "calendar",
        "props": {
          "events": "{/calendarEvents}",
          "view": "month",
          "date": "{/todayDate}"
        }
      },
      {
        "id": "upcoming-list",
        "type": "stack",
        "props": {
          "gap": "sm"
        },
        "children": {
          "each": "/upcoming",
          "template": "task-row"
        }
      },
      {
        "id": "upcoming-empty",
        "type": "text",
        "props": {
          "content": "No future tasks yet. Add a day such as friday or 12 nov to place one on the calendar.",
          "variant": "caption",
          "visibleIf": "{/noUpcoming}"
        }
      },
      {
        "id": "all-panel",
        "type": "section",
        "props": {
          "title": "All open",
          "description": "Late first, then by day, time and priority; undated tasks last."
        },
        "children": [
          "all-list",
          "all-empty"
        ]
      },
      {
        "id": "all-list",
        "type": "stack",
        "props": {
          "gap": "sm"
        },
        "children": {
          "each": "/all",
          "template": "task-row"
        }
      },
      {
        "id": "all-empty",
        "type": "text",
        "props": {
          "content": "No open tasks. Quick capture is ready when you need it.",
          "variant": "caption",
          "visibleIf": "{/noOpen}"
        }
      },
      {
        "id": "completed-panel",
        "type": "section",
        "props": {
          "title": "Completed",
          "description": "{/counts/done} completed, newest first"
        },
        "children": [
          "completed-list",
          "completed-empty",
          "clear-bar"
        ]
      },
      {
        "id": "completed-list",
        "type": "stack",
        "props": {
          "gap": "sm"
        },
        "children": {
          "each": "/completed",
          "template": "task-row"
        }
      },
      {
        "id": "completed-empty",
        "type": "text",
        "props": {
          "content": "Completed tasks will appear here.",
          "variant": "caption",
          "visibleIf": "{/noDone}"
        }
      },
      {
        "id": "clear-bar",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm"
        },
        "children": [
          "clear-ask",
          "clear-confirm",
          "clear-cancel"
        ]
      },
      {
        "id": "clear-ask",
        "type": "button",
        "props": {
          "label": "Clear completed",
          "action": "ask_clear_completed",
          "style": "link",
          "visibleIf": "{/canAskClear}"
        }
      },
      {
        "id": "clear-confirm",
        "type": "button",
        "props": {
          "label": "Delete {/counts/done} completed tasks",
          "action": "confirm_clear_completed",
          "style": "danger",
          "visibleIf": "{/clearAsked}"
        }
      },
      {
        "id": "clear-cancel",
        "type": "button",
        "props": {
          "label": "Keep them",
          "action": "cancel_clear_completed",
          "style": "secondary",
          "visibleIf": "{/clearAsked}"
        }
      },
      {
        "id": "insights-panel",
        "type": "section",
        "props": {
          "title": "Insights",
          "description": "Counts come directly from saved task records; no scores or estimates."
        },
        "children": [
          "status-chart",
          "trend-chart"
        ]
      },
      {
        "id": "status-chart",
        "type": "chart",
        "props": {
          "kind": "bar",
          "title": "Open and completed",
          "labels": "{/chart/statusLabels}",
          "series": "{/chart/statusSeries}",
          "height": "sm"
        }
      },
      {
        "id": "trend-chart",
        "type": "chart",
        "props": {
          "kind": "line",
          "title": "Completed each day · last 14 days",
          "labels": "{/chart/trendLabels}",
          "series": "{/chart/trendSeries}",
          "height": "sm"
        }
      },
      {
        "id": "task-row",
        "type": "card",
        "props": {
          "title": "{title}",
          "subtitle": "{meta}",
          "body": "{notes}",
          "badge": "{repeatLabel}",
          "tone": "{tone}"
        },
        "children": [
          "task-actions"
        ]
      },
      {
        "id": "task-actions",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm"
        },
        "children": [
          "task-done",
          "task-snooze",
          "task-select",
          "task-delete",
          "confirm-delete",
          "cancel-delete"
        ]
      },
      {
        "id": "task-done",
        "type": "button",
        "props": {
          "label": "{doneLabel}",
          "action": "toggle_done",
          "payload": {
            "id": "{id}"
          },
          "style": "secondary"
        }
      },
      {
        "id": "task-snooze",
        "type": "button",
        "props": {
          "label": "Tomorrow",
          "action": "snooze",
          "payload": {
            "id": "{id}",
            "to": "tomorrow"
          },
          "style": "link",
          "visibleIf": "{canSnooze}"
        }
      },
      {
        "id": "task-select",
        "type": "button",
        "props": {
          "label": "Edit",
          "action": "select_task",
          "payload": {
            "id": "{id}"
          },
          "style": "link"
        }
      },
      {
        "id": "task-delete",
        "type": "button",
        "props": {
          "label": "Delete",
          "action": "ask_delete",
          "payload": {
            "id": "{id}"
          },
          "style": "link",
          "visibleIf": "{canAskDelete}"
        }
      },
      {
        "id": "confirm-delete",
        "type": "button",
        "props": {
          "label": "Confirm delete",
          "action": "confirm_delete",
          "payload": {
            "id": "{id}"
          },
          "style": "danger",
          "visibleIf": "{confirmDelete}"
        }
      },
      {
        "id": "cancel-delete",
        "type": "button",
        "props": {
          "label": "Keep task",
          "action": "cancel_delete",
          "style": "secondary",
          "visibleIf": "{confirmDelete}"
        }
      }
    ]
  },
  {
