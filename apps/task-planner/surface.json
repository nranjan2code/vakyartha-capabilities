      {
        "id": "new-form",
        "type": "form",
        "props": {
          "submit": "save_task",
          "submitLabel": "Save task"
        },
        "children": [
          "new-title",
          "dictate-new-title",
          "new-date",
          "new-time",
          "new-duration",
          "new-priority",
          "new-repeat",
          "new-notes",
          "dictate-new-notes"
        ]
      },
      {
        "id": "new-title",
        "type": "input",
        "props": {
          "label": "Task",
          "bind": "/draft/title",
          "placeholder": "A clear next action"
        }
      },
      {
        "id": "dictate-new-title",
        "type": "button",
        "props": {
          "label": "Dictate task title",
          "action": "voice.dictate",
          "payload": {
            "into": "new-title"
          },
          "style": "secondary"
        }
      },
      {
        "id": "new-date",
        "type": "date",
        "props": {
          "label": "Due date",
          "bind": "/draft/dueDate"
        }
      },
      {
        "id": "new-time",
        "type": "input",
        "props": {
          "label": "Start time",
          "kind": "time",
          "bind": "/draft/startTime"
        }
      },
      {
        "id": "new-duration",
        "type": "select",
        "props": {
          "label": "Time block",
          "bind": "/draft/durationMin",
          "options": [
            {
              "label": "15 minutes",
              "value": "15"
            },
            {
              "label": "30 minutes",
              "value": "30"
            },
            {
              "label": "45 minutes",
              "value": "45"
            },
            {
              "label": "1 hour",
              "value": "60"
            },
            {
              "label": "1.5 hours",
              "value": "90"
            },
            {
              "label": "2 hours",
              "value": "120"
            }
          ]
        }
      },
      {
        "id": "new-priority",
        "type": "select",
        "props": {
          "label": "Priority",
          "bind": "/draft/priority",
          "options": [
            {
              "label": "Normal",
              "value": "normal"
            },
            {
              "label": "High",
              "value": "high"
            },
            {
              "label": "Low",
              "value": "low"
            }
          ]
        }
      },
      {
        "id": "new-repeat",
        "type": "select",
        "props": {
          "label": "Repeat after completion",
          "bind": "/draft/repeat",
          "options": [
            {
              "label": "Never",
              "value": "none"
            },
            {
              "label": "Daily",
              "value": "daily"
            },
            {
              "label": "Weekly",
              "value": "weekly"
            },
            {
              "label": "Monthly",
              "value": "monthly"
            }
          ]
        }
      },
      {
        "id": "new-notes",
        "type": "textarea",
        "props": {
          "label": "Notes",
          "bind": "/draft/notes",
          "placeholder": "Optional context"
        }
      },
      {
        "id": "dictate-new-notes",
        "type": "button",
        "props": {
          "label": "Dictate notes",
          "action": "voice.dictate",
          "payload": {
            "into": "new-notes"
          },
          "style": "secondary"
        }
      },
      {
        "id": "read-detail",
        "type": "button",
        "props": {
          "label": "Read task aloud",
          "action": "voice.read",
          "payload": {
            "text": "/spoken/detail"
          },
          "style": "secondary"
        }
      }
