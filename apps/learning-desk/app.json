{
  "id": "learning-desk",
  "version": "1.0.0",
  "name": "Learning Desk",
  "description": "Follow a question into a short course. Discover, save, practise, listen and watch; create course drafts with your assistant and curate your own learning library.",
  "author": "Vakyartha",
  "icon": "book",
  "category": "productivity",
  "entrypoints": {
    "backend": "server.ts",
    "surface": "surface.json",
    "render": "renderApp"
  },
  "runtime": {
    "engine": "node26",
    "memoryLimitMb": 256,
    "cpuTimeLimitSec": 30,
    "maxStorageMb": 16
  },
  "entitlements": {
    "network": {
      "mode": "airgap",
      "allowedDomains": []
    },
    "mcpTools": [],
    "storage": {
      "duckdb": false
    },
    "toolActions": {},
    "toolPurposes": {}
  },
  "triggers": [],
  "voice": {
    "listen": {
      "surface": "lesson",
      "path": "/spoken/lesson",
      "label": "Listen to this lesson"
    }
  },
  "exports": {
    "tools": [
      {
        "name": "get_authoring_context",
        "description": "Read Learning Desk learner preferences, course package contract and current expectedRevision before proposing a course draft",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "title": "Read course preferences"
      },
      {
        "name": "propose_course",
        "description": "Save a complete course as an unreviewed draft in Learning Desk. Does not publish, enrol, change progress or call any model. Read current expectedRevision first. Requires integration permission.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "expectedRevision": {
              "type": "integer",
              "minimum": 1
            },
            "course": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "topic": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "age": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "level": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 60
                },
                "sources": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "url": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000,
                        "description": "The HTTPS link of a page read in this conversation"
                      }
                    },
                    "required": [
                      "title",
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  "description": "Only pages read in this conversation through a source tool, with the title and link exactly as read. Omit this, or send an empty list, when no page was read. Learning Desk shows listed links as not checked."
                },
                "lessons": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "objective": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "explanation": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 5000
                      },
                      "example": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1500
                      },
                      "activity": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "question": {
                        "type": "object",
                        "properties": {
                          "prompt": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 400
                          },
                          "choices": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 4,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 240
                            }
                          },
                          "answer": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 3
                          },
                          "explanation": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          }
                        },
                        "required": [
                          "prompt",
                          "choices",
                          "answer",
                          "explanation"
                        ],
                        "additionalProperties": false
                      },
                      "lab": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "share"
                            ]
                          },
                          "part": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1000000
                          },
                          "whole": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 1000000
                          }
                        },
                        "required": [
                          "kind",
                          "part",
                          "whole"
                        ],
                        "additionalProperties": false,
                        "description": "Optional part/whole experiment. Include only when the lesson objective explicitly teaches a proportional share. Omit for unrelated subjects; do not copy one onto every lesson."
                      },
                      "media": {
                        "type": "object",
                        "description": "Optional actual media asset. Never invent a URL or use a webpage as a video. Leave absent when no asset exists.",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "video",
                              "audio"
                            ]
                          },
                          "url": {
                            "type": "string",
                            "maxLength": 2000,
                            "description": "Existing media:UUID from media tools, or credential-free HTTPS URL to an actual playable video or audio file"
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          },
                          "transcript": {
                            "type": "string",
                            "maxLength": 12000
                          }
                        },
                        "required": [
                          "kind",
                          "url",
                          "title"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "title",
                      "objective",
                      "explanation",
                      "example",
                      "activity",
                      "question"
                    ],
                    "additionalProperties": false
                  }
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "Mathematics",
                    "Science",
                    "Reading & media",
                    "Technology",
                    "Life & work",
                    "Other"
                  ]
                }
              },
              "required": [
                "title",
                "summary",
                "topic",
                "age",
                "level",
                "minutes",
                "lessons"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "expectedRevision",
            "course"
          ],
          "additionalProperties": false
        },
        "title": "Save a course draft"
      }
    ],
    "skills": [
      {
        "name": "learning-author",
        "description": "Create and curate source-aware short courses for Learning Desk, adapting teaching to a learner's age, prior knowledge and goal; propose drafts for personal review",
        "path": "SKILLS.md"
      }
    ]
  }
}
