        "props": {
          "label": "Save changes",
          "action": "save_clinic",
          "style": "primary"
        }
      },
      {
        "id": "doctors",
        "type": "section",
        "props": {
          "title": "{/doctorsTitle}",
          "description": "{/doctorText}"
        },
        "children": [
