      {
        "id": "production-status",
        "type": "text",
        "props": {
          "region": "status",
          "content": "Create a project or import source material",
          "variant": "caption"
        }
      },
      {
        "id": "root",
        "type": "workspace",
        "props": {
          "label": "Video Studio editor"
