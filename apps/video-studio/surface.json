        },
        "children": [
          "creator-paths"
        ]
      },
      {
        "id": "creator-paths",
        "type": "grid",
        "props": {
          "columns": 2,
          "minItemWidth": "md",
          "gap": "md"
        },
        "children": [
          "new-production",
          "source-production"
        ]
      },
      {
        "id": "new-production",
        "type": "section",
        "props": {
          "title": "Create a production",
          "description": "Describe the show or short you want to make."
        },
        "children": [
          "creator-topic",
          "creator-format",
          "assistant-create"
        ]
      },
      {
        "id": "creator-topic",
        "type": "input",
        "props": {
          "label": "Production brief",
          "bind": "/topic",
          "placeholder": "What should this be about?"
        }
      },
      {
        "id": "creator-format",
        "type": "select",
        "props": {
          "label": "Format",
          "bind": "/format",
          "options": "{/formatOptions}",
          "presentation": "dropdown"
        }
      },
      {
        "id": "assistant-create",
        "type": "button",
        "props": {
          "label": "Create with assistant",
          "action": "assistant.compose",
          "payload": {
            "path": "authorRequest",
            "workflowPath": "authorWorkflow"
          },
          "style": "primary"
        }
      },
      {
        "id": "source-production",
        "type": "section",
        "props": {
          "title": "Use a saved programme",
