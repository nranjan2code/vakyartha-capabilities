  {
    "id": "studio",
    "title": "Creator Studio",
    "nodes": [
      {
        "id": "new",
        "type": "button",
        "props": {
          "label": "New project",
          "action": "new_project",
          "glyph": "plus",
          "iconOnly": true,
          "style": "link",
          "payload": {}
        }
      },
      {
        "id": "projects",
        "type": "button",
        "props": {
          "label": "Projects",
          "action": "panel_projects",
          "glyph": "folder",
          "iconOnly": true,
          "style": "link",
          "payload": {}
        }
      },
      {
        "id": "sources",
        "type": "button",
        "props": {
          "label": "Sources from apps",
          "action": "panel_sources",
          "glyph": "globe",
          "iconOnly": true,
          "style": "link",
          "payload": {}
        }
      },
      {
        "id": "media",
        "type": "button",
        "props": {
          "label": "Media",
          "action": "panel_media",
          "glyph": "film",
          "iconOnly": true,
          "style": "link",
          "payload": {}
        }
      },
      {
        "id": "scene",
        "type": "button",
        "props": {
          "label": "Scene properties",
          "action": "panel_scene",
          "glyph": "sliders",
          "iconOnly": true,
          "style": "link",
          "payload": {}
        }
      },
      {
        "id": "history",
        "type": "button",
        "props": {
          "label": "History and checkpoints",
          "action": "panel_history",
          "glyph": "clock",
          "iconOnly": true,
          "style": "link",
          "payload": {}
        }
      },
      {
        "id": "assistant",
        "type": "button",
        "props": {
          "label": "Create with assistant",
          "action": "assistant.compose",
          "glyph": "bolt",
          "iconOnly": true,
          "style": "link",
          "payload": {
            "path": "authorRequest",
            "workflowPath": "authorWorkflow"
          }
        }
      },
      {
        "id": "production-toolbar",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm",
          "region": "toolbar"
        },
        "children": [
          "new",
          "projects",
          "sources",
          "media",
          "scene",
          "history",
          "assistant"
        ]
      },
      {
        "id": "brief",
        "type": "input",
        "props": {
          "label": "Production brief",
          "bind": "/topic"
        }
      },
      {
        "id": "new-format",
        "type": "select",
        "props": {
          "label": "Format",
          "bind": "/format",
          "options": [
            {
              "label": "Show",
              "value": "show"
            },
            {
              "label": "Short",
              "value": "short"
            }
          ],
          "presentation": "dropdown"
        }
      },
      {
        "id": "create-project",
        "type": "button",
        "props": {
          "label": "Create project",
          "action": "new_project",
          "glyph": "plus",
          "iconOnly": true,
          "style": "link",
          "payload": {}
        }
      },
      {
        "id": "project-list",
        "type": "grid",
        "props": {
          "columns": 1,
          "pageSize": 8,
          "searchable": true
        },
        "children": {
          "each": "/projects",
          "template": "project-row"
        }
      },
      {
        "id": "project-row",
        "type": "card",
        "props": {
          "title": "{title}",
          "subtitle": "{status}"
        },
        "children": [
          "project-open"
        ]
      },
      {
        "id": "project-open",
        "type": "button",
        "props": {
          "label": "Open project",
          "action": "open_video",
          "glyph": "film",
          "iconOnly": true,
          "style": "link",
          "payload": {
            "id": "{id}"
          }
        }
      },
      {
        "id": "production-sidebar",
        "type": "stack",
        "props": {
          "region": "sidebar",
          "gap": "sm"
        },
        "children": [
          "brief",
          "new-format",
          "create-project",
          "project-list"
        ]
      },
      {
        "id": "programme-stage",
        "type": "stage",
        "props": {
          "value": {
            "title": "Create a project",
            "segments": []
          },
          "label": "Programme preview"
        }
      },
      {
        "id": "play",
        "type": "button",
        "props": {
          "label": "Play programme in place",
          "action": "voice.play",
          "glyph": "play",
          "iconOnly": true,
          "style": "link",
          "payload": {
            "programme": {},
            "time": "{/creator/cursor}"
          },
          "disabled": true
        }
      },
      {
        "id": "watch-scene",
        "type": "button",
        "props": {
          "label": "Watch from this scene",
          "action": "voice.watch",
          "glyph": "eye",
          "iconOnly": true,
          "style": "link",
          "payload": {
            "queue": {},
            "from": 0,
            "portrait": false
          },
          "disabled": true
        }
      },
      {
        "id": "pause",
        "type": "button",
        "props": {
          "label": "Pause or continue",
          "action": "voice.pause",
          "glyph": "pause",
          "iconOnly": true,
          "style": "link",
          "payload": {}
        }
      },
      {
        "id": "stop",
        "type": "button",
        "props": {
          "label": "Stop",
          "action": "voice.stop",
          "glyph": "stop",
          "iconOnly": true,
          "style": "link",
          "payload": {}
        }
      },
      {
        "id": "measure",
        "type": "button",
        "props": {
          "label": "Prepare and measure narration",
          "action": "voice.prepare",
          "glyph": "clock",
          "iconOnly": true,
          "style": "link",
          "payload": {
            "programme": {},
            "result": "prepared_timings"
          },
          "disabled": true
        }
      },
      {
        "id": "landscape",
        "type": "button",
        "props": {
          "label": "Landscape",
          "action": "landscape",
          "glyph": "film",
          "iconOnly": true,
          "style": "link",
          "payload": {},
          "pressed": true
        }
      },
      {
        "id": "portrait",
        "type": "button",
        "props": {
          "label": "Portrait",
          "action": "portrait",
          "glyph": "film",
          "iconOnly": true,
          "style": "link",
          "payload": {},
          "pressed": false
        }
      },
      {
        "id": "captions",
        "type": "button",
        "props": {
          "label": "Captions",
          "action": "toggle_captions",
          "glyph": "info",
          "iconOnly": true,
          "style": "link",
          "payload": {},
          "pressed": false
        }
      },
      {
        "id": "loop",
        "type": "button",
        "props": {
          "label": "Loop selected clip or programme",
          "action": "toggle_loop",
          "glyph": "redo",
          "iconOnly": true,
          "style": "link",
          "payload": {},
          "pressed": false
        }
      },
      {
        "id": "transport",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm"
        },
        "children": [
          "play",
          "watch-scene",
          "pause",
          "stop",
          "measure",
          "landscape",
          "portrait",
          "captions",
          "loop"
        ]
      },
      {
        "id": "production-preview",
        "type": "stack",
        "props": {
          "region": "preview",
          "gap": "sm"
