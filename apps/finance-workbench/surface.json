      {
        "id": "work",
        "type": "split",
        "props": {
          "ratio": "1:2",
          "gap": "md"
        },
        "children": [
          "editor",
          "list-empty"
        ]
      },
      {
        "id": "editor",
        "type": "section",
        "props": {
          "title": "Add a transaction"
        },
        "children": [
          "e-kind",
          "e-figures",
          "e-description",
          "e-categories",
          "e-actions"
        ]
      },
      {
        "id": "e-kind",
        "type": "select",
        "props": {
          "label": "Type",
          "bind": "/entry/kind",
          "options": [
            {
              "label": "Expense",
              "value": "out"
            },
            {
              "label": "Income",
              "value": "in"
            }
          ]
        }
      },
      {
        "id": "e-figures",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm",
          "align": "end"
        },
        "children": [
          "e-amount",
          "e-date"
        ]
      },
      {
        "id": "e-amount",
        "type": "input",
        "props": {
          "label": "Amount · INR",
          "bind": "/entry/amount",
          "kind": "number",
          "min": 0,
          "step": 0.01,
          "placeholder": "250.00",
          "maxWidth": "sm"
        }
      },
      {
        "id": "e-date",
        "type": "date",
        "props": {
          "label": "Date",
          "bind": "/entry/date",
          "maxWidth": "sm"
        }
      },
      {
        "id": "e-description",
        "type": "input",
        "props": {
          "label": "Description",
          "bind": "/entry/description",
          "placeholder": "Groceries"
        }
      },
      {
        "id": "e-categories",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm",
          "align": "end"
        },
        "children": [
          "e-category",
          "e-new"
        ]
      },
      {
        "id": "e-category",
        "type": "select",
        "props": {
          "label": "Category",
          "bind": "/entry/category",
          "options": "{/categoryOptions}",
          "presentation": "dropdown",
          "maxWidth": "sm"
        }
      },
      {
        "id": "e-new",
        "type": "input",
        "props": {
          "label": "Or a new category",
          "bind": "/entry/newCategory",
          "maxWidth": "sm"
        }
      },
      {
        "id": "e-actions",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm",
          "align": "end"
        },
        "children": [
          "e-save",
          "e-chat"
        ]
      },
      {
        "id": "e-save",
        "type": "button",
        "props": {
          "label": "Add",
          "action": "save_entry",
          "style": "primary"
        }
      },
      {
        "id": "e-chat",
        "type": "button",
        "props": {
          "label": "Add by chat",
          "action": "assistant.compose",
          "style": "link",
          "payload": {
            "path": "assistantRequest",
            "workflowPath": "assistantWorkflow"
          }
        }
      },
      {
        "id": "list-empty",
        "type": "text",
        "props": {
          "content": "Your transactions are listed here, newest first, with search. Choose one to change or delete it.",
          "variant": "caption"
        }
      }
    ]
