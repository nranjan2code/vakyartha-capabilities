[
  {
    "id": "overview",
    "title": "Overview",
    "data": {},
    "nodes": [
      {
        "id": "root",
        "type": "stack",
        "props": {
          "gap": "md",
          "density": "compact"
        },
        "children": [
          "fin-empty"
        ]
      },
      {
        "id": "fin-empty",
        "type": "card",
        "props": {
          "title": "Start your ledger",
          "body": "Add what you earn and spend as it happens, or import your own records. Totals, limits and charts appear here. Nothing leaves this computer."
        },
        "children": [
          "empty-bar"
        ]
      },
      {
        "id": "empty-bar",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm",
          "align": "end"
        },
        "children": [
          "start-add",
          "start-import"
        ]
      },
      {
        "id": "start-add",
        "type": "button",
        "props": {
          "label": "Add a transaction",
          "action": "view.open",
          "style": "primary",
          "payload": {
            "surface": "ledger"
          }
        }
      },
      {
        "id": "start-import",
        "type": "button",
        "props": {
          "label": "Import a file",
          "action": "view.open",
          "style": "secondary",
          "payload": {
            "surface": "import"
          }
        }
      }
    ]
  },
  {
    "id": "ledger",
    "title": "Transactions",
    "data": {
      "entry": {
        "kind": "out",
        "amount": "",
        "date": "",
        "description": "",
        "category": "",
        "newCategory": ""
      },
      "assistantRequest": "Add these to my ledger: ",
      "assistantWorkflow": {
        "title": "Add by chat",
        "brief": "What you spent or received",
        "boundary": "The assistant reads your categories and adds the transactions you describe, after you approve them. It never deletes or changes a saved transaction.",
        "saved": "Added to your ledger. Check them in the list, and choose one to change it.",
        "steps": [
          {
            "id": "add",
            "label": "Add transactions",
            "mode": "edit",
            "message": "Add these to my ledger: "
          },
          {
            "id": "month",
            "label": "Summarise this month",
            "mode": "send",
            "message": "Read my ledger and summarise this month: money in, money out, what is left of my limits and the largest expenses. Use only what the ledger returned."
          }
        ],
        "review": {
          "label": "See the transactions",
          "surface": "ledger",
          "tool": "add_transactions"
        }
      },
      "categoryOptions": [
        "Education",
        "Entertainment",
        "Food",
        "Groceries",
        "Health",
        "Housing",
        "Income",
        "Other",
        "Shopping",
        "Transport",
        "Travel",
        "Utilities"
      ],
      "summary": "Record money in and money out as it happens. Amounts are exact to the paisa and stay on this computer."
    },
    "nodes": [
      {
        "id": "root",
        "type": "stack",
        "props": {
          "gap": "md",
          "density": "compact"
        },
        "children": [
          "cap",
          "work"
        ]
      },
      {
        "id": "cap",
        "type": "text",
        "props": {
          "content": "{/summary}",
          "variant": "caption"
