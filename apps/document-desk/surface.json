[
  {
    "id": "library",
    "title": "Library",
    "data": {
      "summary": "Your documents, kept as searchable text.",
      "query": "",
      "mode": "smart",
      "kind": "all",
      "notice": "",
      "documents": [],
      "attention": [],
      "route": {
        "keywords": ""
      }
    },
    "nodes": [
      {
        "id": "root",
        "type": "stack",
        "props": {
          "gap": "md",
          "density": "compact"
        },
        "children": [
          "summary",
          "toolbar",
          "welcome"
        ]
      },
      {
        "id": "summary",
        "type": "text",
        "props": {
          "content": "{/summary}",
          "variant": "caption"
        }
      },
      {
        "id": "toolbar",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm",
          "align": "end"
        },
        "children": [
          "query",
          "mode",
          "kind",
          "go",
          "add",
          "share"
        ]
      },
      {
        "id": "query",
        "type": "input",
        "props": {
          "label": "Search",
          "bind": "/query",
          "placeholder": "Words, \"an exact phrase\", or -word to leave out"
        }
      },
      {
        "id": "mode",
        "type": "select",
        "props": {
          "label": "Match",
          "bind": "/mode",
          "options": [
            {
              "value": "smart",
              "label": "Best match"
            },
            {
              "value": "exact",
              "label": "Exact text"
            },
            {
              "value": "regex",
              "label": "Pattern"
            }
          ],
          "presentation": "dropdown",
          "maxWidth": "sm"
        }
      },
      {
        "id": "kind",
        "type": "select",
        "props": {
          "label": "Kind",
          "bind": "/kind",
          "options": [
            {
              "value": "all",
              "label": "All kinds"
            },
            {
              "value": "pdf",
              "label": "PDF"
            },
            {
              "value": "word",
              "label": "Word"
            },
            {
              "value": "markdown",
              "label": "Markdown"
            },
            {
              "value": "web",
              "label": "Web pages"
            },
            {
              "value": "sheet",
              "label": "Spreadsheets"
            },
            {
              "value": "text",
              "label": "Text"
            }
          ],
          "presentation": "dropdown",
          "maxWidth": "sm"
        }
      },
      {
        "id": "go",
        "type": "button",
        "props": {
          "label": "Search",
          "action": "search",
          "style": "primary"
        }
      },
      {
        "id": "add",
        "type": "button",
        "props": {
          "label": "Add documents",
          "action": "documents.upload",
          "payload": {
            "then": "add_uploads"
          },
          "style": "secondary"
        }
      },
      {
        "id": "share",
        "type": "button",
        "props": {
          "label": "Share a folder",
          "action": "documents.folders",
          "payload": {
            "then": "sync"
          },
          "style": "secondary"
        }
      },
      {
        "id": "welcome",
        "type": "section",
        "props": {
          "title": "Start your library",
          "description": "Add PDF, Word, Markdown, web page, spreadsheet or text files, or share a folder and the library keeps itself in step with it. Everything becomes searchable text; the files stay yours and are never changed."
        },
        "children": [
          "welcome-bar"
        ]
      },
      {
        "id": "welcome-bar",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "wrap": true,
          "gap": "sm"
        },
        "children": [
          "welcome-add",
          "welcome-share"
        ]
      },
      {
        "id": "welcome-add",
        "type": "button",
        "props": {
          "label": "Add documents",
          "action": "documents.upload",
          "payload": {
            "then": "add_uploads"
          },
          "style": "primary"
        }
      },
      {
        "id": "welcome-share",
        "type": "button",
        "props": {
          "label": "Share a folder",
          "action": "documents.folders",
          "payload": {
            "then": "sync"
          },
          "style": "secondary"
        }
      }
    ]
  },
