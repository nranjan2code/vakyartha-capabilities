          "content": "Daily NSE history saved on this computer: up to five years per stock (from 2 Nov 2021), then each new session. 10 of 15 stocks · benchmark not saved yet · storage 0.0 of 2 MiB.",
          "variant": "caption"
        }
      },
      {
        "id": "prog",
        "type": "progress",
        "props": {
          "label": "History saving in the background · 0 of 10 stocks",
          "value": 0,
          "show": "value"
        }
      },
      {
        "id": "controls",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "wrap": true,
          "align": "end"
        },
        "children": [
          "add",
          "add-go",
          "bench",
          "sync"
        ]
      },
      {
        "id": "add",
        "type": "input",
        "props": {
          "label": "Add stocks",
          "bind": "/addDraft",
          "placeholder": "TATAMOTORS, MARUTI"
        }
      },
      {
        "id": "add-go",
        "type": "button",
        "props": {
          "label": "Add",
          "action": "add_symbols",
          "style": "primary"
        }
      },
      {
        "id": "bench",
        "type": "select",
        "props": {
          "label": "Benchmark and calendar",
          "bind": "/benchmark",
          "presentation": "dropdown",
          "maxWidth": "sm",
          "options": [
            "Nifty 50",
            "Nifty 500",
            "Nifty Next 50",
            "Nifty Bank",
            "Nifty Midcap 100"
          ]
        }
      },
      {
        "id": "sync",
        "type": "button",
        "props": {
          "label": "Sync now",
          "action": "sync",
          "style": "secondary"
        }
      },
      {
        "id": "tabs",
        "type": "tabs",
        "props": {},
        "children": [
          "tabs-stocks-10",
          "tabs-corporate-actions-0",
          "tabs-sources-0"
        ]
      },
      {
        "id": "tabs-stocks-10",
        "type": "section",
        "props": {
          "title": "Stocks · 10"
        },
        "children": [
          "st-grid",
          "st-note"
        ]
      },
      {
        "id": "tabs-corporate-actions-0",
        "type": "section",
        "props": {
          "title": "Corporate actions · 0"
        },
        "children": [
          "ca-none"
        ]
      },
      {
        "id": "tabs-sources-0",
        "type": "section",
        "props": {
          "title": "Sources · 0"
        },
        "children": [
          "rc-none"
        ]
      },
      {
        "id": "st-grid",
        "type": "grid",
        "props": {
          "columns": 3,
          "minItemWidth": "sm",
          "gap": "sm",
          "searchable": false,
          "pageSize": 24
        },
        "children": {
          "each": "/stocks",
          "template": "st-card"
        }
      },
      {
        "id": "st-card",
        "type": "card",
        "props": {
          "title": "{title}",
          "subtitle": "{subtitle}",
          "body": "{body}",
          "badge": "{badge}",
          "tone": "{tone}"
        },
        "children": [
          "st-actions"
        ]
      },
      {
        "id": "st-actions",
        "type": "stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm"
        },
        "children": [
          "st-retry",
          "st-remove"
        ]
      },
      {
        "id": "st-retry",
        "type": "button",
        "props": {
          "label": "Sync again",
          "action": "retry_symbol",
          "payload": {
            "symbol": "{symbol}"
          },
          "style": "link"
        }
      },
      {
        "id": "st-remove",
        "type": "button",
        "props": {
          "label": "{confirm}",
          "action": "remove_symbol",
          "payload": {
            "symbol": "{symbol}"
          },
          "style": "link"
        }
      },
      {
        "id": "st-note",
        "type": "text",
        "props": {
          "content": "The scheduled sync runs every two minutes while Background operation is on; Sync now runs one step. Each step reads at most fifteen chunks, so the first full history of ten stocks takes about twenty minutes. Five years of 15 stocks use about 1.5 MiB of the app’s 2 MiB storage.",
          "variant": "caption"
        }
      },
      {
        "id": "ca-none",
        "type": "text",
        "props": {
          "content": "No corporate actions saved yet; they are checked weekly once a stock’s history is complete.",
          "variant": "caption"
        }
      },
      {
        "id": "rc-none",
        "type": "text",
        "props": {
          "content": "No reads yet. Press Sync now, or turn on Background operation.",
          "variant": "caption"
        }
      }
    ]
  }
]
