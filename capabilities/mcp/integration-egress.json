{
  "hosts": [
    {
      "host": "air-quality-api.open-meteo.com"
    },
    {
      "host": "api.open-meteo.com"
    },
    {
      "host": "archive-api.open-meteo.com"
    },
    {
      "host": "climate-api.open-meteo.com"
    },
    {
      "host": "ensemble-api.open-meteo.com"
    },
    {
      "host": "flood-api.open-meteo.com"
    },
    {
      "host": "geocoding-api.open-meteo.com"
    },
    {
      "host": "marine-api.open-meteo.com"
    },
    {
      "host": "seasonal-api.open-meteo.com"
    },
    {
      "host": "api.elevenlabs.io",
      "credential": {
        "account": "ELEVENLABS_API_KEY",
        "header": "xi-api-key",
        "format": "{value}"
      }
    },
    {
      "host": "api.githubcopilot.com",
      "credential": {
        "account": "INTEGRATION_GITHUB_TOKEN",
        "header": "authorization",
        "format": "Bearer {value}"
      }
    },
    {
      "host": "api.notion.com"
    },
    {
      "host": "api.search.brave.com"
    },
    {
      "host": "api.telegram.org"
    },
    {
      "host": "context7.com"
    },
    {
      "host": "glama.ai",
      "credential": {
        "account": "GLAMA_API_KEY",
        "header": "authorization",
        "format": "Bearer {value}"
      }
    },
    {
      "host": "huggingface.co"
    },
    {
      "host": "learn.microsoft.com"
    },
    {
      "host": "knowledge-mcp.global.api.aws"
    },
    {
      "host": "docs.mcp.cloudflare.com"
    },
    {
      "host": "mcp.deepwiki.com"
    },
    {
      "host": "mcp.kite.trade"
    },
    {
      "host": "mcp.nseindia.in"
    },
    {
      "host": "mcp.tavily.com",
      "credential": {
        "account": "INTEGRATION_TAVILY_APIKEY",
        "header": "authorization",
        "format": "Bearer {value}"
      }
    },
    {
      "host": "registry.npmjs.org"
    }
  ],
  "servers": {
    "brave-search": {
      "hosts": [
        "api.search.brave.com"
      ],
      "env": {
        "BRAVE_API_KEY": "INTEGRATION_BRAVE_SEARCH_APIKEY"
      }
    },
    "context7": {
      "hosts": [
        "context7.com"
      ],
      "env": {
        "CONTEXT7_API_KEY": "INTEGRATION_CONTEXT7_APIKEY"
      }
    },
    "open-meteo": {
      "hosts": [
        "air-quality-api.open-meteo.com",
        "api.open-meteo.com",
        "archive-api.open-meteo.com",
        "climate-api.open-meteo.com",
        "ensemble-api.open-meteo.com",
        "flood-api.open-meteo.com",
        "geocoding-api.open-meteo.com",
        "marine-api.open-meteo.com",
        "seasonal-api.open-meteo.com"
      ],
      "env": {},
      "toolHosts": {
        "geocoding": [
          "geocoding-api.open-meteo.com"
        ],
        "weather_forecast": [
          "api.open-meteo.com"
        ],
        "air_quality": [
          "air-quality-api.open-meteo.com"
        ],
        "weather_archive": [
          "archive-api.open-meteo.com"
        ],
        "marine_weather": [
          "marine-api.open-meteo.com"
        ],
        "flood_forecast": [
          "flood-api.open-meteo.com"
        ]
      }
    },
    "notion": {
      "hosts": [
        "api.notion.com"
      ],
      "env": {
        "NOTION_TOKEN": "INTEGRATION_NOTION_TOKEN"
      }
    }
  }
}
